rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lakshanrajapaksha327@gmail.com';
    }

    function isValidRole(role) {
      return role in ['superAdmin', 'president', 'secretary', 'projectEditor', 'mediaEditor', 'viewer'];
    }

    function canUploadMedia() {
      return isBootstrappedSuperAdmin() || (
        isSignedIn() &&
        request.auth.uid != null &&
        true
      );
    }

    // Public published club media (images <= 20 MB, videos <= 100 MB, PDFs <= 25 MB)
    match /public/{module}/{recordId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (
        isBootstrappedSuperAdmin() ||
        request.auth.token.email != null
      ) && (
        (
          request.resource != null &&
          (
            (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 20 * 1024 * 1024) ||
            (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 100 * 1024 * 1024) ||
            (request.resource.contentType == 'application/pdf' && request.resource.size <= 25 * 1024 * 1024)
          )
        ) ||
        request.resource == null
      );
    }

    // Private internal club documents (approval letters, receipts, internal member rosters)
    // Never publicly readable; only signed-in verified admin accounts may read/write.
    match /private/{module}/{recordId}/{fileName} {
      allow read: if isSignedIn() && canUploadMedia();
      allow write: if isSignedIn() && canUploadMedia() && (
        (
          request.resource != null &&
          request.resource.size <= 25 * 1024 * 1024 &&
          request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)')
        ) ||
        request.resource == null
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
